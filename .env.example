# Copy to `.env` (gitignored) for local Electron builds / `npm run dev`.
# Release builds inject the same keys from GitHub Actions secrets.

# ── Service connections (OAuth Desktop apps) ──────────────────────────
# Register once in Google Cloud Console + GitHub Developer settings,
# then put values here (local) or in repo Actions secrets (CI release).
#
# GitHub → Settings → Secrets and variables → Actions:
#   PAWN_GOOGLE_CLIENT_ID
#   PAWN_GOOGLE_CLIENT_SECRET
#   PAWN_GITHUB_CLIENT_ID
#   PAWN_GITHUB_CLIENT_SECRET
#
# Optional runtime override without rebuild: ~/.pawn/oauth-clients.json

PAWN_GOOGLE_CLIENT_ID=
PAWN_GOOGLE_CLIENT_SECRET=
PAWN_GITHUB_CLIENT_ID=
PAWN_GITHUB_CLIENT_SECRET=

# ── Optional provider defaults (users usually set these in Settings) ──
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
